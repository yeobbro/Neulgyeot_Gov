# Copy to .env.local. Never commit real values.
# Managed PostgreSQL (Neon / Supabase / RDS ...). If unset the app runs an in-memory DEMO database.
DATABASE_URL=
# 32+ random chars. Required in production unless DEMO_MODE=true.
SESSION_SECRET=
APP_URL=http://localhost:3000
# true = synthetic-data demo (demo login enabled, non-persistent DB allowed)
DEMO_MODE=true
# Optional: password for seeded DEMO accounts (12+ chars). Demo picker works without it.
DEMO_PASSWORD=
# Demo hospital integration API key (bearer). Default is a public, non-secret demo key.
HOSPITAL_INTEGRATION_DEMO_KEY=
# AI: rule-based drafts are always available. No external (cloud) LLM path exists in the code.
# Optional local LLM (OpenAI-compatible: Ollama, vLLM, LM Studio...) — see docs/LOCAL_LLM.md.
# Synthetic data only; drafts still need human approval; tenant AI switch must be on.
AI_PROVIDER=
# e.g. AI_PROVIDER=local_llm  LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=
# Only if the institution's inference server requires a bearer key.
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_MS=120000
LOCAL_LLM_MAX_TOKENS=1500
# true = run the AI job worker inside `next start` (single-machine demo only; refused on Vercel).
AI_INPROCESS_WORKER=false
