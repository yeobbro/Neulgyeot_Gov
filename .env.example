# Copy to .env.local. Never commit real values.
# Managed PostgreSQL (Neon / Supabase / RDS ...). If unset the app runs an in-memory DEMO database.
DATABASE_URL=
# 32+ random chars. Required in production unless DEMO_MODE=true.
SESSION_SECRET=
APP_URL=http://localhost:3000
# true = synthetic-data demo (demo login enabled, non-persistent DB allowed)
DEMO_MODE=true
# Optional: password for seeded DEMO accounts (12+ chars). Demo picker works without it.
DEMO_PASSWORD=
# Demo hospital integration API key (bearer). Default is a public, non-secret demo key.
HOSPITAL_INTEGRATION_DEMO_KEY=
# AI: rule-based drafts always available. External LLM only if all three are set.
AI_FEATURE_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=
